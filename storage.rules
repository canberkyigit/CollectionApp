rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSafeImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    match /users/{userId}/items/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isSafeImage();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/avatars/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/documents/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/(jpeg|jpg|png|webp))');
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
