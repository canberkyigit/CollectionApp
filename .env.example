VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=your-app-id

# Public web address of the app (no trailing slash), used for QR codes on printed
# labels and shared links. Needed because the desktop app runs on http://localhost,
# which a phone cannot open. If unset, https://<VITE_FIREBASE_PROJECT_ID>.web.app is used.
VITE_PUBLIC_APP_URL=
